; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FlatMC"
config/description="FlatMC - 2D Minecraft Game"
config/version="Alpha v0.2.1"
run/main_scene="res://assets/scenes/menus/game_init_menu.tscn"
run/disable_stderr=true
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.894118, 0.211765, 0.243137, 1)
boot_splash/show_image=false
boot_splash/image="res://assets/textures/ui/fmc_author_page.png"
config/icon="res://assets/textures/ui/fmc_icon.png"

[autoload]

StaticLoad="*res://assets/scenes/others/StaticLoad.tscn"
ServiceDiscovery="*res://addons/lan_servers_discovery/servers_discovery.gd"
UUID="*res://addons/uuid/uuid.gd"
ResourceLoadingMenu="*res://assets/scenes/menus/resource_loading_menu.tscn"
AudioManager="*res://assets/scripts/managers/audio_manager.gd"
DataManager="*res://assets/scripts/managers/data_manager.gd"
SceneManager="*res://assets/scripts/managers/scene_manager.gd"
ServerManager="*res://assets/scripts/managers/server_manager.gd"
SettingsManager="*res://assets/scripts/managers/settings_manager.gd"
TextureManager="*res://assets/scripts/managers/texture_manager.gd"
WorldManager="*res://assets/scripts/managers/world_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="FlatMC"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/lan_servers_discovery/plugin.cfg", "res://addons/uuid/plugin.cfg")

[gui]

theme/custom="res://assets/themes/ui_theme.tres"
theme/custom_font="res://assets/fonts/fmcles.tres"

[importer_defaults]

animation_library={
"animation/fps": 60.0
}
texture={
"detect_3d/compress_to": 0
}
csv_translation={
"delimiter": 1
}

