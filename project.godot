[input_devices]

pointing/emulate_mouse_from_touch=false

[internationalization]

locale/translation_remaps={}
locale/translations=PackedStringArray("res://assets/languages/translation.de.translation", "res://assets/languages/translation.en.translation", "res://assets/languages/translation.es.translation", "res://assets/languages/translation.fr.translation", "res://assets/languages/translation.hi.translation", "res://assets/languages/translation.ja.translation", "res://assets/languages/translation.ko.translation", "res://assets/languages/translation.ru.translation", "res://assets/languages/translation.th.translation", "res://assets/languages/translation.vi.translation", "res://assets/languages/translation.zh.translation")

[memory]

limits/message_queue/max_size_mb=64

[physics]

2d/default_gravity=2750.0

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver="opengl"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/driver.windows="d3d12"
